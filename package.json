{
  "name": "estecapelli-theme",
  "version": "1.18.0",
  "private": true,
  "description": "Build tooling for the Estecapelli WordPress theme (Tailwind v4 CSS).",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/src/tailwind.css -o ./assets/css/main.css --minify",
    "watch:css": "tailwindcss -i ./assets/src/tailwind.css -o ./assets/css/main.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "tailwindcss": "^4.3.0"
  }
}
