# Default: auto-detect text, normalize to LF on commit
* text=auto eol=lf

# Source files: always LF (Linux server)
*.php   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.xml   text eol=lf
*.svg   text eol=lf
*.po    text eol=lf
*.pot   text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Shell scripts: must be LF
*.sh    text eol=lf

# Windows-only files: keep CRLF
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Binary files: never touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.mo    binary
*.zip   binary
*.pdf   binary
