<wpml-config>

    <!--
        Tells WPML what the theme's custom content is. WPML auto-loads this file
        from the theme root.

        - Treatments and Doctors are translatable custom post types; they fall
          back to English until a translation exists, so no language is ever
          missing a page.
        - Treatment Categories are translatable — their translated slugs form the
          per-language URL base (e.g. greffe-de-cheveux).

        The ACF content fields (page_sections, doctor bio/position/credentials)
        are deliberately NOT listed here: they are managed by ACFML (ACF
        Multilingual), which understands ACF's structure — it translates the real
        text and preserves the flexible-content layout selectors. Listing them
        here would make WPML translate the raw values (including the internal
        section layout names), which breaks rendering. ACFML must be active.
    -->

    <custom-types>
        <custom-type translate="1" display-as-translated="1">treatment</custom-type>
        <custom-type translate="1" display-as-translated="1">doctor</custom-type>
    </custom-types>

    <taxonomies>
        <taxonomy translate="1">treatment_category</taxonomy>
    </taxonomies>

</wpml-config>
